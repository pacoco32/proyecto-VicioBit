# Java

# Evita subir archivos compilados de Java
*.class

# Maven

# Excluye la carpeta donde Maven guarda los archivos generados
target/

# Excluye el archivo del wrapper de Maven
.mvn/wrapper/maven-wrapper.jar

# IntelliJ IDEA

# Excluye la configuración local del proyecto en IntelliJ
.idea/

# Excluye los archivos de configuración de módulos de IntelliJ
*.iml

# Excluye la configuración local de Visual Studio Code, por si lo usamos
# Visual Studio Code
.vscode/

# Sistema operativo

# Excluye archivos auxiliares de macOS, por si es el elegido
.DS_Store

# Excluye archivos auxiliares de Windows
Thumbs.db

# Logs

# Excluye los archivos de registro de la aplicación
*.log

# Credenciales de Firebase
*serviceAccount*.json
*firebase-adminsdk*.json
